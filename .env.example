# Copy to ignored .env.local, edit locally, then run .\scripts\dev.ps1.
# The Go executable itself still reads process environment variables only.
APP_ENV=development
HTTP_ADDR=127.0.0.1:18080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# Browser origins allowed to call this API directly. Empty disables CORS.
# Comma-separated exact origins; no wildcard or URL paths. Set this on Render.
CORS_ALLOWED_ORIGINS=
# Example: https://web-kohl-delta-90.vercel.app

# Required; replace the placeholder password locally. Never commit credentials.
DATABASE_URL=postgres://hostelhive:REPLACE_ME@127.0.0.1:15433/hostelhive?sslmode=disable
DATABASE_CHECK_TIMEOUT=2s
# Required Firebase project ID (not the display name).
FIREBASE_PROJECT_ID=your-firebase-project-id
AUTH_TIMEOUT=5s
# For local development, set this to a credential file OUTSIDE the repository.
GOOGLE_APPLICATION_CREDENTIALS=C:/private/hostelhive-service-account.json

# Deadline for the provisioning workflow after authentication.
PROVISIONING_TIMEOUT=8s

# Account listing/changes and each background revocation attempt.
ACCOUNT_MANAGEMENT_TIMEOUT=8s

# Deadline for student-profile operations after authentication.
STUDENT_PROFILE_TIMEOUT=8s
INVENTORY_TIMEOUT=8s
# Duplicate movement suppression; positive duration, at most 5m.
ATTENDANCE_COOLDOWN=10s

# Optional realtime attendance projection. PostgreSQL stays authoritative.
RTDB_ENABLED=false
# Create RTDB in locked mode, deploy firebase/database.rules.json first.
# FIREBASE_DATABASE_URL=https://your-database.firebasedatabase.app

# Optional private student images. Disabled endpoints return 503.
R2_ENABLED=false
# Set all four values in your process environment when enabled.
# R2_ACCOUNT_ID=your-32-character-account-id
# R2_BUCKET=hostelhive-private-images
# R2_ACCESS_KEY_ID=replace-locally
# R2_SECRET_ACCESS_KEY=replace-locally

# Direction-specific late-access request policy (#74).
HOSTEL_TIMEZONE=Asia/Colombo
HOSTEL_EXIT_OPENING=06:00
HOSTEL_ENTRY_DEADLINE=20:00

# Mobile push delivery (#89). Keep disabled until FCM/mobile setup is verified.
FCM_ENABLED=false

# Student invitations (#95). Apply migration26 before running this version.
# Keep disabled until Firebase sendEmail permission and email templates are ready.
STUDENT_INVITATIONS_ENABLED=false
STUDENT_EMAIL_DOMAINS=stu.kln.ac.lk
